[Unit]
Description=SOC Minis event and booking service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=soc-minis
Group=soc-minis
WorkingDirectory=/var/lib/soc-minis
StateDirectory=soc-minis
StateDirectoryMode=0700
RuntimeDirectory=soc-minis
RuntimeDirectoryMode=0750
Environment=SOC_SOCKET=/run/soc-minis/app.sock
Environment=SOC_BASE=/soc
Environment=SOC_DATA=/var/lib/soc-minis
Environment=SOC_FRONTEND=/opt/soc-minis/current/frontend
EnvironmentFile=-/etc/soc-minis/service.env
ExecStart=/opt/soc-minis/current/soc serve
UMask=0077
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
